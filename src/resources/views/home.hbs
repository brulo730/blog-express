{{!-- <h1>{{courses}}</h1> --}}

<div class='row'>
    {{#each courses}}
        <div class='col-md-4 mb-4'>
            <div class='card card-cource-item' class='text-decoration-none'>
                <a href='/course/{{this.slug}}'>
                {{!-- /course/ là đg dẫn tuyệt đối tính từ gốc domain(/) | course: là router course  --}}
                    <img
                        src='{{this.image}}'
                        alt='{{this.name}}'
                        class='card-img-top'
                    />
                </a>
                <div class='card-body'>
                    <a
                        href='/course/{{this.slug}}'
                        class='text-decoration-none'
                    >
                        <h5 class='card-name'>{{this.name}}</h5>
                    </a>
                    <p class='card-desc'>{{this.description}}</p>
                    <a href='#' class='btn btn-primary'>Mua khóa học</a>
                </div>
            </div>
        </div>
    {{/each}}
</div>